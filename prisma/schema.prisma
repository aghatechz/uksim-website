// Prisma schema for Vodafone Pakistan SIM Distribution Store
// Database Provider: PostgreSQL (Local Server on Port 5432)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String   @id @default(cuid())
  name          String
  category      String
  price         Float
  originalPrice Float
  rating        Float    @default(5.0)
  reviewsCount  Int      @default(0)
  image         String
  description   String
  isBestSeller  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique // e.g. VOD-849201
  customerName  String
  phone         String
  email         String?
  city          String
  address       String
  landmark      String?
  notes         String?
  totalAmount   Float
  paymentMethod String      @default("Cash on Delivery")
  status        String      @default("Pending") // Pending, Confirmed, Dispatched, Delivered, Cancelled
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  name      String
  qty       Int     @default(1)
  price     Float
  image     String
  carrier   String
}
